{
  "name": "emulix-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "brand": "node scripts/build-brand-assets.mjs",
    "frames": "node scripts/build-device-frames.mjs",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy",
    "db:status": "node --env-file=.env node_modules/prisma/build/index.js migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "lighthouse": "13.5.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "playwright-webkit-15": "npm:playwright-core@1.23.4",
    "playwright-webkit-16": "npm:playwright-core@1.30.0",
    "playwright-webkit-17": "npm:playwright-core@1.40.1",
    "playwright-webkit-18": "npm:playwright-core@1.47.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.39.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
