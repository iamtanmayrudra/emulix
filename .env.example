# Copy to .env (or .env.local) for local development, then restart `npm run dev`.
# Those files are ignored by git. Never commit real secrets.

# --- AI features (docs/AI_FEATURES.md) ---
# Turns on "Draft with AI" and "Explain". Leave it empty to keep AI off; the AI buttons then say AI is not set up.
ANTHROPIC_API_KEY=

# Optional model overrides. The defaults are shown.
# AI_TEXT_MODEL=claude-haiku-5-5
# AI_VISION_MODEL=claude-sonnet-5-5

# --- App ---
# Application environment label shown in diagnostics only.
NEXT_PUBLIC_APP_ENV=development

# Public base URL used in emailed links (verify, reset, invite). It must be the address you open the app on, so use the
# port `npm run dev` prints. Required in production. Server-only, so it has no NEXT_PUBLIC_ prefix.
APP_URL=http://localhost:3000

# --- Email (docs/EMAIL_SERVICE.md) ---
# Server-only. Never give these a NEXT_PUBLIC_ name: the browser must not see the key.
# With both set, emails go out through Resend. Leave them empty in development to print emails in the server console.
# In production both are required, and sending fails loudly without them.
RESEND_API_KEY=
# A sender on a domain verified in Resend, for example: Emulix Optimizer <auth@yourdomain.com>
EMAIL_FROM=

# --- Database (docs/DATABASE.md) ---
# Postgres connection string. With it, accounts and sessions are stored in the database and shared by every server
# instance. Without it they live in memory: fine locally, but sign-in breaks on Netlify, which runs many instances.
# Apply the tables once with: npm run db:migrate
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Audits and live browsers on a hosted site (docs/NETLIFY_LIMITS.md) ---
# Netlify and other serverless hosts cannot run a browser. There, Optimization audits go through Google PageSpeed
# Insights, and live device testing shows a "not available" message. A free API key avoids the shared quota, which is
# often used up. Create one in Google Cloud Console (APIs & Services -> Credentials) with the PageSpeed Insights API
# enabled. Server-only: never give it a NEXT_PUBLIC_ name.
PAGESPEED_API_KEY=
# Optional. on = use the local Playwright browser even on a host that looks serverless, off = never use it.
# LIVE_BROWSER=

# Placeholders for later phases. Keep server-only values out of NEXT_PUBLIC_* names.
# QUEUE_URL=
# OBJECT_STORAGE_BUCKET=
# BILLING_PROVIDER_SECRET_KEY=
